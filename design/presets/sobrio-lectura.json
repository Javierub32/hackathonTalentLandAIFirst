{
  "name": "sobrio-lectura",
  "fonts": {
    "display": {
      "family": "Atkinson Hyperlegible",
      "package": "@fontsource/atkinson-hyperlegible"
    },
    "body": {
      "family": "Atkinson Hyperlegible",
      "package": "@fontsource/atkinson-hyperlegible"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "package": "@fontsource/ibm-plex-mono"
    }
  },
  "colors": {
    "light": {
      "background": "oklch(0.985 0.008 150)",
      "foreground": "oklch(0.23 0.012 160)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.23 0.012 160)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.23 0.012 160)",
      "primary": "oklch(0.44 0.1 160)",
      "primary-foreground": "oklch(1 0 0)",
      "secondary": "oklch(0.95 0.035 150)",
      "secondary-foreground": "oklch(0.3 0.08 152)",
      "muted": "oklch(0.965 0.008 150)",
      "muted-foreground": "oklch(0.43 0.015 160)",
      "accent": "oklch(0.92 0.05 150)",
      "accent-foreground": "oklch(0.28 0.08 152)",
      "destructive": "oklch(0.5 0.19 27)",
      "destructive-foreground": "oklch(1 0 0)",
      "border": "oklch(0.87 0.012 150)",
      "input": "oklch(0.56 0.015 160)",
      "ring": "oklch(0.4 0.1 160)",
      "chart-1": "oklch(0.55 0.13 152)",
      "chart-2": "oklch(0.6 0.12 230)",
      "chart-3": "oklch(0.7 0.14 85)",
      "chart-4": "oklch(0.55 0.15 30)",
      "chart-5": "oklch(0.5 0.08 300)"
    }
  },
  "radius": "0.375rem",
  "shadow": {
    "sm": "0 1px 0 0 oklch(0.23 0.012 160 / 10%)",
    "md": "0 0 0 1px oklch(0.87 0.012 150)",
    "lg": "0 0 0 1px oklch(0.87 0.012 150), 0 2px 0 0 oklch(0.47 0.12 152 / 25%)"
  },
  "motion": {
    "duration": {
      "fast": 120,
      "base": 200,
      "slow": 300
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "emphasized": [
        0.3,
        0,
        0,
        1
      ]
    },
    "spring": {
      "stiffness": 300,
      "damping": 40,
      "mass": 1
    }
  },
  "focus": {
    "width": "3px",
    "offset": "2px"
  },
  "reducedMotion": {
    "duration": {
      "fast": 0,
      "base": 0,
      "slow": 0
    },
    "spring": {
      "stiffness": 1000,
      "damping": 100
    }
  },
  "effects": [
    "DrawnUnderline",
    "ScrollProgressRule"
  ]
}