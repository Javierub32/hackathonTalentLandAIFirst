      "foreground": "oklch(0.319 0.046 168)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.319 0.046 168)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.319 0.046 168)",
      "primary": "oklch(0.355 0.048 168)",
      "primary-foreground": "oklch(0.983 0.004 135)",
      "secondary": "oklch(0.928 0.024 151)",
      "secondary-foreground": "oklch(0.319 0.046 168)",
      "muted": "oklch(0.944 0.013 149)",
      "muted-foreground": "oklch(0.484 0.039 165)",
      "accent": "oklch(0.897 0.043 145)",
      "accent-foreground": "oklch(0.319 0.046 168)",
      "destructive": "oklch(0.5 0.19 27)",
      "destructive-foreground": "oklch(0.99 0.004 95)",
      "border": "oklch(0.878 0.020 155)",
