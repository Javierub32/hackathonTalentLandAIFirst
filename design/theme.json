      "ring": "oklch(0.448 0.065 163)",
      "chart-1": "oklch(0.355 0.048 168)",
      "chart-2": "oklch(0.6 0.1 230)",
      "chart-3": "oklch(0.448 0.065 163)",
      "chart-4": "oklch(0.58 0.14 35)",
      "chart-5": "oklch(0.5 0.06 300)"
    }
  },
  "radius": "0.4rem",
  "shadow": {
    "sm": "0 1px 0 0 oklch(0.319 0.046 168 / 8%)",
    "md": "0 0 0 1px oklch(0.878 0.020 155)",
    "lg": "0 6px 0 -2px oklch(0.897 0.043 145)"
  },
  "motion": {
    "duration": {
      "fast": 120,
      "base": 200,
      "slow": 300
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "emphasized": [
        0.3,
        0,
        0,
        1
      ]
    },
    "spring": {
      "stiffness": 300,
      "damping": 40,
      "mass": 1
    }
  },
  "focus": {
    "width": "3px",
    "offset": "2px"
  },
  "reducedMotion": {
    "duration": {
      "fast": 0,
      "base": 0,
      "slow": 0
    },
    "spring": {
      "stiffness": 1000,
      "damping": 100
    }
  },
  "effects": [
    "DrawnUnderline",
    "ScrollProgressRule"
  ]
